# ─── CerebroSpeak Environment Variables ───
# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env file.

# AI Provider API Keys
ANTHROPIC_API_KEY=your-anthropic-key-here
DEEPGRAM_API_KEY=your-deepgram-key-here
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=your-chosen-voice-id-here
EMBEDDINGS_API_KEY=your-embeddings-key-here

# Database
DATABASE_URL=sqlite+aiosqlite:///./cerebrospeak.db

# Application
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
